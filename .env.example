# Separate Algofort database. Never reuse the OXGEN database.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/algofort?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/algofort?sslmode=require"
# Aiven CA certificate, PEM text (use \n for newlines in a single-line env value).
DATABASE_CA_CERT=""
SESSION_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# 32 random bytes encoded in base64; preserve this key across deployments.
CREDENTIAL_ENCRYPTION_KEY=""
APP_URL="http://localhost:3100"
